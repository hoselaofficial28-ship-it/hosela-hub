# Salin file ini jadi .env lalu isi nilainya. JANGAN commit file .env (sudah di-.gitignore).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ^ hanya untuk Edge Function/server, JANGAN PERNAH dipakai di kode frontend/browser.

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# ^ isi dengan JSON service account Google (satu baris), simpan sebagai Supabase secret nanti, bukan di sini untuk produksi.
